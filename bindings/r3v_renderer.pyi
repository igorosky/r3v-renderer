# What CpuTesselator.update_input_geometry takes as a block: PointI, or
# anything else with these methods, such as r3v_voxelizer.PointI.
class _PointILike(Protocol):
    def x(self) -> int: ...
    def y(self) -> int: ...
    def z(self) -> int: ...
    def i(self) -> int: ...

